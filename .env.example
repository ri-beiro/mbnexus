# Frontend (público — nunca colocar segredos aqui, ver docs/architecture.md secao 7/8)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Supabase (server-side / Edge Functions / CLI) — NUNCA prefixar com VITE_
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Microsoft Entra ID / Graph (usado apenas em Edge Functions, fase 8)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# SMTP Locaweb (usado apenas em Edge Functions, fase 7)
LOCAWEB_SMTP_HOST=
LOCAWEB_SMTP_PORT=587
LOCAWEB_SMTP_USER=
LOCAWEB_SMTP_PASSWORD=
